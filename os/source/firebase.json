{
    "hosting":  {
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "public":  "dist",
                    "headers":  [
                                    {
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-store"
                                                        }
                                                    ],
                                        "source":  "/index.html"
                                    },
                                    {
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "public, max-age=31536000, immutable"
                                                        }
                                                    ],
                                        "source":  "/assets/**"
                                    }
                                ],
                    "rewrites":  [
                                     {
                                         "destination":  "/index.html",
                                         "source":  "**"
                                     }
                                 ]
                }
}
